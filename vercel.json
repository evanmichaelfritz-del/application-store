{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/check-vercel-routes.mjs && node scripts/check-prompts.mjs && npx setup-skia-web public && npx expo export --platform web && cp dist/index.html dist/404.html",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/playground",
      "destination": "/index.html"
    },
    {
      "source": "/a/:slug(card-resize|number-pop-in|notification-badge|text-states-swap|menu-dropdown|yogesh-thinking-orbs|confetti-burst|modal-open-close|gooey-plus-menu|page-side-by-side|icon-swap|success-check|avatar-group-hover|card-stack-hover|error-state-shake|input-clear-dissolve|skeleton-reveal|texts-reveal|tabs-sliding|drag-drop-physics|shimmer-text|image-generation-loader|tooltip-open-close|tilt-3d|border-beam|orb-solving|orb-thinking|orb-agent-listening|orb-searching|orb-agent-planning|orb-agent-thinking|orb-working|orb-agent-shaping|gooey|liquid-metal|abrar-overview|preview-tools|orb-state-picker|yogesh-orb-creator)",
      "destination": "/index.html"
    },
    {
      "source": "/c/:type(inputs-pickers|buttons|menus-overlays|cards|navigation|text-effects|backgrounds-shaders|loaders|data-display)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/canvaskit.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
